{
  "name": "makerspace-core-desktop-terminal",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build:bootstrap": "vite build",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "dev": "tauri dev --features custom-protocol",
    "build": "tauri build",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build:bootstrap && pnpm build:sidecar && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@carbon/react": "1.118.0",
    "@carbon/styles": "1.118.0",
    "@ibm/plex": "6.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "sass": "1.105.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
