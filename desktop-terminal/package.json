{
  "name": "makerspace-core-desktop-terminal",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build:bootstrap": "vite build",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "dev": "tauri dev",
    "build": "tauri build",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build:bootstrap && pnpm build:sidecar && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@carbon/react": "1.116.0",
    "@carbon/styles": "1.115.0",
    "@ibm/plex": "6.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "sass": "1.104.1",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
