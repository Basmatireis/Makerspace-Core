     "x": 0,
     "y": 104.88,
     "w": 10.71,
     "h": 0.49,
     "stroke": 0,
     "fill": "$c:ink"
    },
    {
     "id": "fold-mark-2",
     "type": "rect",
     "title": "Fold mark",
     "x": 0,
     "y": 210.03,
     "w": 10.71,
     "h": 0.49,
     "stroke": 0,
     "fill": "$c:ink"
    }
   ]
  },
  {
