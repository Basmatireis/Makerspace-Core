{
 "schemaVersion": 1,
 "name": "HTU Kassabuch",
 "export": "cashbook",
 "page": {
  "size": "A4",
  "orientation": "portrait",
  "margins": [
   52.08,
   20,
   20,
   20
  ],
  "font": "Helvetica",
  "baseSize": 9,
  "accent": "$c:ink",
  "locale": "de",
  "accentBar": false,
  "filename": "cashbook-{{period.kind}}-{{period.from | date(\"yyyy-MM-dd\")}}-{{period.to | date(\"yyyy-MM-dd\")}}.pdf"
 },
 "styles": {
  "colors": [
   {
    "id": "ink",
    "name": "Form ink",
    "value": "#3c3c3c"
   },
   {
    "id": "rule",
    "name": "Form rule",
    "value": "#000000"
   },
   {
    "id": "grey",
    "name": "Form grey",
    "value": "#7f7f7f"
   },
   {
    "id": "reference",
    "name": "Reference",
    "value": "#6f6f6f"
   }
  ],
  "text": [
   {
    "id": "title",
    "name": "Form title",
    "font": "Helvetica",
    "size": 18.0,
    "weight": 600,
    "lineHeight": 1.2,
    "color": "$c:ink"
   },
   {
    "id": "label",
    "name": "Form label",
    "font": "Helvetica",
    "size": 11.04,
    "weight": 600,
    "lineHeight": 1.1476,
    "color": "$c:ink"
   },
   {
    "id": "labelRegular",
    "name": "Form entry",
    "font": "Helvetica",
    "size": 11.04,
    "weight": 400,
    "lineHeight": 1.1476,
    "color": "$c:ink"
   },
   {
    "id": "entry",
    "name": "Table entry",
    "font": "Helvetica",
    "size": 9,
    "weight": 400,
    "lineHeight": 1.1,
    "color": "$c:ink"
   },
   {
    "id": "reference",
    "name": "Receipt number",
    "font": "Helvetica",
    "size": 7,
    "weight": 400,
    "lineHeight": 1.1,
    "color": "$c:reference"
   },
   {
    "id": "amount",
    "name": "Sum",
    "font": "Helvetica",
    "size": 10.0,
    "weight": 600,
    "lineHeight": 1.2,
    "color": "$c:ink"
   }
  ],
  "sizes": [
   {
    "id": "rule",
    "name": "Form rule",
    "value": 0.17,
    "unit": "mm"
   },
   {
    "id": "row",
    "name": "Row height",
    "value": 9.457,
    "unit": "mm"
   },
   {
    "id": "rowFirst",
    "name": "Row height, first sheet",
    "value": 9.4536,
    "unit": "mm"
   }
  ]
 },
 "layers": [
  {
   "id": "letterhead",
