     "textStyle": "labelRegular"
    },
    {
     "id": "head-year-label-frame",
     "type": "rect",
     "title": "Year label frame",
     "x": 20.03,
     "y": 75.27,
     "w": 37.55,
     "h": 10,
     "stroke": "$s:rule",
     "color": "$c:rule"
    },
    {
     "id": "head-year-frame",
     "type": "rect",
     "title": "Year frame",
     "x": 57.58,
     "y": 75.27,
     "w": 132.49,
     "h": 10,
     "stroke": "$s:rule",
     "color": "$c:rule"
    },
    {
     "id": "head-year-label",
     "type": "ptext",
     "title": "Year label",
     "x": 21.91,
     "y": 75.6,
     "w": 33.79,
     "text": "Wirtschaftsjahr",
     "textStyle": "label"
    },
    {
     "id": "head-year",
     "type": "ptext",
     "title": "Business year and period",
     "x": 59.46,
     "y": 75.6,
     "w": 128.73,
     "text": "{{period.businessYear}} · Zeitraum {{period.from | date}} – {{period.to | date}}{{period.contents | prefix(\" · \")}}",
     "textStyle": "labelRegular"
    }
   ]
  },
  {
   "id": "closing-sheet",
   "type": "layer",
   "title": "Closing sheet: totals and signatures",
   "pages": "last",
   "elements": [
    {
     "id": "closing-total-frame",
