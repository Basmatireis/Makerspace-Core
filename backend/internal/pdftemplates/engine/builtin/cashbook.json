     "y": 73.86,
     "w": 123.19,
     "text": "Endbestand (Wirtschaftsjahr)",
     "textStyle": "label",
     "align": "right"
    },
    {
     "id": "closing-closing-in",
     "type": "ptext",
     "title": "Einnahme",
     "x": 145.1,
     "y": 73.93,
     "w": 20.66,
     "text": "{{totals.closing | number(2)}}",
     "textStyle": "amount",
     "align": "right"
    },
    {
     "id": "signature-1-frame",
     "type": "rect",
     "title": "Signature label frame",
     "x": 20.03,
     "y": 80.61,
     "w": 95.14,
     "h": 19.65,
     "stroke": "$s:rule",
     "color": "$c:rule"
    },
    {
     "id": "signature-1-field",
     "type": "rect",
     "title": "Signature field",
     "x": 115.17,
