 ],
 "header": [],
 "body": [
  {
   "id": "contents",
   "type": "if",
   "title": "Cash register or all payments",
   "when": {
    "path": "period.contents",
    "op": "empty"
   },
   "then": [
    {
     "id": "sheet-cash",
     "type": "sheet",
     "title": "Kassabuch sheets, cash register",
     "source": "lines",
     "as": "line",
     "firstTop": 85.27,
     "nextTop": 52.08,
     "rowsFirst": 14,
     "rowsNext": 17,
     "rowHeight": "$s:row",
     "rowHeightFirst": "$s:rowFirst",
     "headHeight": 9.44,
     "headHeightFirst": 4.67,
     "carryHeight": 9.48,
     "carryHeightFirst": 9.1,
     "sumHeight": 9.44,
     "sumHeightFirst": 9.48,
     "fillEmpty": true,
     "color": "$c:rule",
     "textColor": "$c:ink",
     "subColor": "$c:reference",
     "stroke": "$s:rule",
     "headerStyle": "label",
     "bodyStyle": "entry",
     "subStyle": "reference",
     "totalsStyle": "amount",
     "columns": [
      {
       "header": "Nr.",
       "value": "{{line.no}}",
       "x": 20.03,
       "w": 15.07,
       "align": "left"
      },
      {
       "header": "Datum",
       "value": "{{line.date | date}}",
       "x": 35.1,
       "w": 22.48,
       "align": "left"
      },
      {
       "header": "Kassierer*in",
       "value": "{{line.cashier}}",
       "x": 57.58,
       "w": 27.52,
       "align": "left"
      },
      {
       "header": "Text",
       "value": "{{line.text}}{{line.orderSummary | prefix(\" · \")}}",
       "sub": "{{line.receiptNumber}}",
       "x": 85.1,
       "w": 60.0,
       "align": "left"
      },
      {
       "header": "Einnahme",
       "value": "{{line.in | amount}}",
       "x": 145.1,
       "w": 22.54,
       "align": "right"
      },
      {
       "header": "Ausgabe",
       "value": "{{line.out | amount}}",
       "x": 167.64,
       "w": 22.43,
       "align": "right"
      }
     ],
     "carry": {
      "label": "Bestand/Übertrag von\nvorheriger Seite",
      "value": "{{sheet.carry | number(2)}}",
      "outFill": "$c:grey"
     },
     "sum": {
      "label": "Summe/Bestand",
      "in": "{{sheet.balance | number(2)}}",
      "out": "",
      "outFill": "$c:grey"
     }
    }
   ],
   "else": [
    {
     "id": "sheet-all",
     "type": "sheet",
     "title": "Kassabuch sheets, all payments",
     "source": "lines",
     "as": "line",
     "firstTop": 85.27,
     "nextTop": 52.08,
     "rowsFirst": 14,
     "rowsNext": 17,
     "rowHeight": "$s:row",
     "rowHeightFirst": "$s:rowFirst",
     "headHeight": 9.44,
     "headHeightFirst": 4.67,
     "carryHeight": 9.48,
     "carryHeightFirst": 9.1,
     "sumHeight": 9.44,
     "sumHeightFirst": 9.48,
     "fillEmpty": true,
     "color": "$c:rule",
     "textColor": "$c:ink",
     "subColor": "$c:reference",
     "stroke": "$s:rule",
     "headerStyle": "label",
     "bodyStyle": "entry",
     "subStyle": "reference",
     "totalsStyle": "amount",
     "columns": [
      {
       "header": "Nr.",
       "value": "{{line.no}}",
       "x": 20.03,
       "w": 15.07,
       "align": "left"
      },
      {
       "header": "Datum",
       "value": "{{line.date | date}}",
       "x": 35.1,
       "w": 22.48,
       "align": "left"
      },
      {
       "header": "Kassierer*in",
       "value": "{{line.cashier}}",
       "x": 57.58,
       "w": 27.52,
       "align": "left"
      },
      {
       "header": "Text",
       "value": "{{line.text}}{{line.orderSummary | prefix(\" · \")}}{{line.method | prefix(\" (\") | suffix(\")\")}}",
       "sub": "{{line.receiptNumber}}",
       "x": 85.1,
       "w": 60.0,
       "align": "left"
      },
      {
       "header": "Einnahme",
       "value": "{{line.in | amount}}",
       "x": 145.1,
       "w": 22.54,
       "align": "right"
      },
      {
       "header": "Ausgabe",
       "value": "{{line.out | amount}}",
       "x": 167.64,
       "w": 22.43,
       "align": "right"
      }
     ],
     "carry": {
      "label": "Bestand/Übertrag von\nvorheriger Seite",
      "value": "",
      "outFill": "$c:grey"
     },
     "sum": {
      "label": "Summe/Bestand",
      "in": "{{sheet.sumIn | number(2)}}",
      "out": "{{sheet.sumOut | number(2)}}"
     }
    }
   ]
  },
  {
   "id": "closing-break",
   "type": "pagebreak",
   "title": "Closing sheet"
  }
 ],
 "footer": []
}
