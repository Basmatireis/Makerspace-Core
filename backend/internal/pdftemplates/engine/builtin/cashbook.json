     "x": 20.03,
     "y": 64.38,
     "w": 123.19,
     "text": "Anfangsbestand (Wirtschaftsjahr)",
     "textStyle": "label",
     "align": "right"
    },
    {
     "id": "closing-opening-in",
     "type": "ptext",
     "title": "Einnahme",
     "x": 145.1,
     "y": 64.43,
     "w": 20.66,
     "text": "{{totals.opening | number(2)}}",
     "textStyle": "amount",
     "align": "right"
    },
    {
     "id": "closing-closing-frame",
     "type": "rect",
     "title": "Endbestand (Wirtschaftsjahr) frame",
     "x": 20.03,
     "y": 71.08,
     "w": 125.07,
     "h": 9.53,
     "stroke": "$s:rule",
     "color": "$c:rule"
    },
    {
     "id": "closing-closing-in-frame",
     "type": "rect",
     "title": "Einnahme frame",
     "x": 145.1,
     "y": 71.08,
     "w": 22.54,
     "h": 9.53,
     "stroke": "$s:rule",
     "color": "$c:rule"
    },
    {
     "id": "closing-closing-out-frame",
     "type": "rect",
     "title": "Ausgabe frame",
     "x": 167.64,
     "y": 71.08,
     "w": 22.43,
     "h": 9.53,
     "stroke": "$s:rule",
     "color": "$c:rule",
     "fill": "$c:grey"
    },
    {
     "id": "closing-closing-label",
     "type": "ptext",
     "title": "Endbestand (Wirtschaftsjahr)",
