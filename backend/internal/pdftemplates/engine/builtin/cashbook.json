     "x": 167.64,
     "y": 52.08,
     "w": 22.43,
     "h": 9.52,
     "stroke": "$s:rule",
     "color": "$c:rule"
    },
    {
     "id": "closing-total-label",
     "type": "ptext",
     "title": "Gesamtsumme (aller Einnahmen & Ausgaben)",
     "x": 20.03,
     "y": 54.86,
     "w": 123.19,
     "text": "Gesamtsumme (aller Einnahmen & Ausgaben)",
     "textStyle": "label",
     "align": "right"
    },
    {
     "id": "closing-total-in",
     "type": "ptext",
     "title": "Einnahme",
     "x": 145.1,
     "y": 54.93,
     "w": 20.66,
     "text": "{{totals.in | number(2)}}",
     "textStyle": "amount",
     "align": "right"
    },
    {
     "id": "closing-total-out",
     "type": "ptext",
     "title": "Ausgabe",
     "x": 167.64,
     "y": 54.93,
     "w": 20.55,
     "text": "{{totals.out | number(2)}}",
     "textStyle": "amount",
     "align": "right"
    },
    {
     "id": "closing-opening-frame",
     "type": "rect",
     "title": "Anfangsbestand (Wirtschaftsjahr) frame",
     "x": 20.03,
     "y": 61.6,
     "w": 125.07,
     "h": 9.48,
     "stroke": "$s:rule",
     "color": "$c:rule"
    },
    {
     "id": "closing-opening-in-frame",
     "type": "rect",
     "title": "Einnahme frame",
     "x": 145.1,
     "y": 61.6,
     "w": 22.54,
     "h": 9.48,
     "stroke": "$s:rule",
     "color": "$c:rule"
    },
    {
     "id": "closing-opening-out-frame",
