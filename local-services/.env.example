# Copy to .env and adjust. See docs/streaming-gateway.md.

# Release of the Makerspace Core images (printer-connector and streaming-gateway).
MAKERSPACE_VERSION=
# Optional digest pinning (see compose.yaml): the digest of each release image, including the "@".
#PRINTER_CONNECTOR_DIGEST=@sha256:
#STREAMING_GATEWAY_DIGEST=@sha256:
#MAKERSPACE_IMAGE_PREFIX=ghcr.io/basmatireis/makerspace-core

# Public HTTPS URL of Makerspace Core.
CORE_URL=https://makerspace.example.org

# Hostname[:port] players use to reach the gateway. It must resolve on the display's network, match
# the TLS certificate, and equal the "public host" configured for this gateway in Core.
STREAM_PUBLIC_HOST=signage-gw.example.org:8443

# LAN IPv4 address of this Docker host. go2rtc advertises it as its WebRTC address (port 8555), so
# displays can reach the media port directly. Use a fixed address (DHCP reservation).
STREAM_LAN_ADDRESS=192.168.1.20

# Optional: publish the ports on one host address only, and use another HTTPS port.
#STREAM_BIND_ADDRESS=192.168.1.20
#STREAM_HTTPS_PORT=8443

# Secret files (host paths). The enrollment secrets can be removed after the first successful start.
CONNECTOR_ENROLLMENT_SECRET_FILE=./secrets/printer-connector-enrollment
STREAM_ENROLLMENT_SECRET_FILE=./secrets/streaming-gateway-enrollment
# TLS certificate chain and private key for STREAM_PUBLIC_HOST (PEM). The gateway runs as uid 10001;
# make the files readable for it (chown 10001:10001, mode 0600 for the key).
STREAM_TLS_CERT_FILE=./secrets/streaming-gateway-tls.crt
STREAM_TLS_KEY_FILE=./secrets/streaming-gateway-tls.key
