# Copy to .env (next to compose.yaml). See docs/hosting.md. Do not commit the populated file.
# The same variable names are used by ../printer-connector and ../streaming-gateway.

# Release of the Makerspace Core images (printer-connector and streaming-gateway). The release
# bundle has its version filled in.
MAKERSPACE_VERSION=0.0.0
# Optional digest pinning: the digest of each release image, including the "@".
#PRINTER_CONNECTOR_DIGEST=@sha256:
#STREAMING_GATEWAY_DIGEST=@sha256:
#MAKERSPACE_IMAGE_PREFIX=ghcr.io/basmatireis/makerspace-core

# Public HTTPS URL of Makerspace Core.
CORE_URL=https://makerspace.example.org
# Only needed when browsers load the player from another origin than CORE_URL.
#STREAM_ALLOWED_ORIGIN=

# Hostname[:port] players use to reach the gateway. It must resolve on the display's network, match
# the TLS certificate in ./certs, and equal the "public host" configured for this gateway in Core.
STREAM_PUBLIC_HOST=signage-gw.example.org:8443

# LAN IPv4 address of this Docker host. go2rtc advertises it as its WebRTC address (port 8555), so
# displays can reach the media port directly. Use a fixed address (DHCP reservation).
STREAM_LAN_ADDRESS=192.168.1.20

# Optional: publish the ports on one host address only, and use another HTTPS port.
#STREAM_BIND_ADDRESS=192.168.1.20
#STREAM_HTTPS_PORT=8443

# One-time enrollment secrets. Printer connector: in Core open Machines > Connectors, create a
# connector. Streaming gateway: Settings > Local services, add a gateway. Copy each secret (shown
# once) here. They are only used for the first start; afterwards the identities live in the data
# volumes, the values are ignored and can be removed (then run `docker compose up -d` again).
CONNECTOR_ENROLLMENT_SECRET=
STREAM_ENROLLMENT_SECRET=

# TLS certificate: put fullchain.pem and privkey.pem for STREAM_PUBLIC_HOST into ./certs (next to
# compose.yaml). The gateway runs as uid 10001 and must be able to read both files.
