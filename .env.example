# Copy to .env for local development. This file contains no application-user credentials.
COMPOSE_PROJECT_NAME=makerspace-core

# PostgreSQL (local development only; choose a different password before first start)
POSTGRES_DB=makerspace
POSTGRES_USER=makerspace
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_PORT=5432

# Published development ports and browser origin
BACKEND_PORT=8080
FRONTEND_PORT=5173
PUBLIC_BASE_URL=http://localhost:5173
VITE_DEV_API_TARGET=http://backend:8080

# Backend runtime
APP_ENV=development
HTTP_ADDR=:8080
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TTL=6h
SESSION_ABSOLUTE_TTL=72h
PASSWORD_RESET_TTL=30m
AUDIT_RETENTION=8760h
MAKERSPACE_TIME_ZONE=Europe/Vienna
OPEN_DAYS_HOLIDAY_COUNTRY=AT
OPEN_DAYS_HOLIDAY_SUBDIVISION=AT-6
OPEN_DAYS_HOLIDAY_LANGUAGE=de

# Optional OpenTelemetry export. The application must run with telemetry disabled.
OTEL_SDK_DISABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy.example.internal:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=makerspace-core-api
