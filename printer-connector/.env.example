# Copy to .env (next to compose.yaml). See docs/hosting.md. Do not commit the populated file.

# Release of the Makerspace Core images. The release bundle has its version filled in.
MAKERSPACE_VERSION=0.0.0
# Optional digest pinning: "@sha256:<digest>" of that release's printer-connector image.
#PRINTER_CONNECTOR_DIGEST=@sha256:
#LOCAL_UPDATER_DIGEST=@sha256:
# (The optional updater comments these pins out when it installs a newer release.)
#MAKERSPACE_IMAGE_PREFIX=ghcr.io/basmatireis/makerspace-core

# Optional updater sidecar (see compose.yaml and docs/hosting.md): staff can then update this bundle
# to Core's version from Settings > Local services. It mounts the Docker socket, which is root access
# to this host; enable it only if that is acceptable. Then run `docker compose up -d`.
#COMPOSE_PROFILES=updater
# Optional: the Docker socket path (rootless Docker: /run/user/<uid>/docker.sock).
#DOCKER_SOCKET=/var/run/docker.sock

# Public HTTPS URL of Makerspace Core (development ignores it and uses http://host.docker.internal:8080).
# The connector only dials out to Core (also for camera video) and publishes no port. An http:// URL
# is refused unless CONNECTOR_ALLOW_HTTP is "true" in compose.yaml; use that only inside a VPN or
# when Core runs on the same host (docs/hosting.md).
CORE_URL=https://makerspace.example.org

# One-time enrollment secret: in Core open Settings > Local services > Printer connectors, create a connector and copy the
# secret shown once. It is only used for the first start; afterwards the identity lives in the data
# volume, the value is ignored and can be removed (then run `docker compose up -d` again).
CONNECTOR_ENROLLMENT_SECRET=
