# Copy this file to a deployment-only location such as .env.production. Do not
# commit the populated file. Image tags omit the leading "v" from Git tags.
COMPOSE_PROJECT_NAME=makerspace-core
MAKERSPACE_IMAGE_PREFIX=ghcr.io/basmatireis/makerspace-core
MAKERSPACE_VERSION=0.4.0

# Exact browser-visible HTTPS origin. Do not include a path or trailing slash.
PUBLIC_BASE_URL=https://makerspace.example.org

# Only the frontend is published. The loopback default is intended for a TLS
# reverse proxy running on the Docker host.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080

# PostgreSQL remains reachable only on the Compose network. Generate a long
# random password using URL-safe characters so the environment file stays easy
# to parse; the password is passed separately rather than embedded in a URL.
POSTGRES_DB=makerspace
POSTGRES_USER=makerspace
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password

# Backend runtime policy.
SESSION_IDLE_TTL=6h
SESSION_ABSOLUTE_TTL=72h
PASSWORD_RESET_TTL=30m
AUDIT_RETENTION=8760h

# Optional OpenTelemetry export. Leave disabled when there is no collector.
OTEL_SDK_DISABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy.example.internal:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=makerspace-core-api
