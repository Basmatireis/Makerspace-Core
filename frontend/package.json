{
  "name": "makerspace-core-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=26 <27"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@carbon/charts",
      "@carbon/charts-react",
      "@carbon/utils-position"
    ]
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build --manifest && pnpm check:bundle",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "generate:api": "orval --config orval.config.ts",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@carbon/charts": "1.27.27",
    "@carbon/charts-react": "1.27.27",
    "@carbon/icons-react": "11.92.0",
    "@carbon/react": "1.121.0",
    "@carbon/styles": "1.120.0",
    "@ibm/plex": "6.4.1",
    "@tanstack/react-query": "5.108.2",
    "dompurify": "3.4.18",
    "marked": "18.2.1",
    "pdfjs-dist": "6.5.438",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "jsdom": "31.0.1",
    "msw": "3.0.7",
    "orval": "8.48.0",
    "prettier": "3.10.1",
    "sass": "1.108.2",
    "typescript": "7.0.2",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
