{
  "name": "makerspace-core-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=26 <27"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@carbon/charts",
      "@carbon/charts-react",
      "@carbon/utils-position"
    ]
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build --manifest && pnpm check:bundle",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "generate:api": "orval --config orval.config.ts",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@carbon/charts": "1.27.23",
    "@carbon/charts-react": "1.27.23",
    "@carbon/icons-react": "11.91.0",
    "@carbon/react": "1.119.0",
    "@carbon/styles": "1.118.0",
    "@dnd-kit/react": "0.5.1",
    "@ibm/plex": "6.4.1",
    "@tanstack/react-query": "5.104.5",
    "dompurify": "3.4.17",
    "marked": "18.1.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "orval": "8.44.0",
    "prettier": "3.9.10",
    "sass": "1.106.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
